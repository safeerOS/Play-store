<!-- Pasica za zaganjalnik Android TV (16:9): znak Safeer Play Store na ozadju Safeer OS -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:width="320dp"
    android:height="180dp"
    android:viewportWidth="320"
    android:viewportHeight="180"
    tools:ignore="VectorRaster">

    <!-- Temno Safeer OS ozadje -->
    <path
        android:fillColor="#0B1310"
        android:pathData="M0,0 H320 V180 H0 Z" />

    <!-- Spodnji val v Safeer slogu -->
    <path
        android:fillColor="#0F1A24"
        android:pathData="M0,124 C90,92 180,156 320,112 V180 H0 Z" />

    <!-- Zgornja prefinjena mint linija -->
    <path
        android:fillAlpha="0.16"
        android:fillColor="#7EDCAB"
        android:pathData="M0,0 H320 V2 H0 Z" />

    <!-- Sredinski znak Safeer Play Store -->
    <group
        android:scaleX="0.75"
        android:scaleY="0.75"
        android:translateX="112"
        android:translateY="38">
        <!-- Zaobljena temna podlaga -->
        <path
            android:fillColor="#14231C"
            android:pathData="M30,0 L98,0 A30,30 0 0 1 128,30 L128,98 A30,30 0 0 1 98,128 L30,128 A30,30 0 0 1 0,98 L0,30 A30,30 0 0 1 30,0 Z" />

        <!-- Safeer zaščitni ščit -->
        <path
            android:fillColor="#7EDCAB"
            android:pathData="M64,22 L96,34 V62 C96,82 83,97 64,106 C45,97 32,82 32,62 V34 Z" />

        <!-- Ročaj torbice trgovine aplikacij -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#142B20"
            android:strokeWidth="5"
            android:strokeLineCap="round"
            android:pathData="M56,52 V46 C56,41 72,41 72,46 V52" />

        <!-- Telo torbice trgovine aplikacij -->
        <path
            android:fillColor="#142B20"
            android:pathData="M48,52 H80 L76,82 C75.5,85.5 73,88 69.5,88 H58.5 C55,88 52.5,85.5 52,82 Z" />

        <!-- Safeer Play simbol -->
        <path
            android:fillColor="#7EDCAB"
            android:pathData="M60,61 L72,68 L60,75 Z" />
    </group>

    <!-- Spodnja mint poudarna črtica -->
    <path
        android:fillColor="#7EDCAB"
        android:pathData="M136,152 h48 v3 h-48 z" />
</vector>
